@startuml ViewChecklistGuestC3

!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master

skinparam linetype ortho
skinparam shadowing false
skinparam componentStyle rectangle

title C3 - View Checklist (Guest Flow)

package "Presentation Layer" {
  [ChecklistViewScreen] <<Screen>>
  [ChecklistViewer] <<Component>>
}

package "Application Layer" {
  [ViewChecklistInput] <<InputContract>>
  [GuestViewChecklistUseCase] <<UseCase>>
  [GuestViewChecklistOutput] <<OutputContract>>
  [GuestChecklistDTO] <<DTO>>

  [IGuestChecklistStorage] <<Interface>>
  [IGuestCheckStorage] <<Interface>>
}

package "Domain Layer" {
  [Checklist] <<Entity>>
  [Check] <<Entity>>
}

package "Infrastructure Layer" {
  [GuestChecklistStorage] <<Query>>
  [GuestCheckStorage] <<Query>>
}

' === FLOW ===
[ChecklistViewScreen] --> [ChecklistViewer]
[ChecklistViewer] --> [ViewChecklistInput]
[ChecklistViewer] --> [GuestViewChecklistUseCase]
[GuestViewChecklistUseCase] --> [IGuestChecklistStorage]
[IGuestChecklistStorage] --> [GuestChecklistStorage]
[GuestViewChecklistUseCase] --> [IGuestCheckStorage]
[IGuestCheckStorage] --> [GuestCheckStorage]
[GuestViewChecklistUseCase] --> [Checklist]
[GuestViewChecklistUseCase] --> [Check]
[GuestViewChecklistUseCase] --> [GuestViewChecklistOutput]
[GuestViewChecklistOutput] --> [GuestChecklistDTO]

@enduml
